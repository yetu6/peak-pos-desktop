{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yetu",
  "version": "0.1.8",
  "identifier": "com.peak.pos",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yetu",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#eef1f6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173 http://127.0.0.1:5173 ws://127.0.0.1:5173 http://localhost:8080 http://127.0.0.1:8080 ws://localhost:8080 ws://127.0.0.1:8080 https: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "625ec6b8-8a11-54d7-b205-232f6ca01684"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MjMzNUU2QTVGNjNEMjEKUldRaFBmYWw1alVqcHM5VUZKWm91NllhUTg1TkZMTjBlbzJjVzlmWm4vbDNTVHJ5Nk9HZTlzUXUK",
      "endpoints": [
        "https://downloads.yetu.fbcsoftwares.com/pos/stable/latest.json"
      ]
    }
  }
}
